# ==============================================================================
# KUBE-RAG Docker Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your credentials
#
# docker-compose will load this .env file automatically
# ==============================================================================

# --- QDRANT VECTOR DATABASE ---
# Option 1: Use cloud Qdrant (recommended for production)
# QDRANT_CLUSTER_ENDPOINT=https://your-qdrant-instance.qdrantcloud.io:6333
# QDRANT_API_KEY=your_qdrant_api_key

# Option 2: Use local Qdrant (docker-compose --profile local)
# QDRANT_CLUSTER_ENDPOINT=http://qdrant:6333
# QDRANT_API_KEY=local-api-key

QDRANT_CLUSTER_ENDPOINT=http://qdrant:6333
QDRANT_API_KEY=qdrant-key-docker

# --- EMBEDDINGS ---
# Options: sentence-transformers (default, local, no rate limits)
#          gemini (requires GEMINI_API_KEY, rate-limited)
EMBEDDING_MODEL=sentence-transformers
GEMINI_API_KEY=

# --- REASONING ENGINE (GROQ) ---
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- OBSERVABILITY ---
# Logfire: https://logfire.pydantic.dev
LOGFIRE_TOKEN=your_logfire_token

# LangSmith: https://smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=kube-rag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- UI BACKEND URL ---
# This is set automatically by docker-compose
# Only needed if running UI outside of docker-compose
BACKEND_URL=http://backend:8080
